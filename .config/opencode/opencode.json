{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4-flash-free",
  "default_agent": "leader",
  "autoupdate": true,
  "instructions": [
    "~/.config/opencode/instructions/standards.md",
    "~/.config/opencode/instructions/versioning.md",
    "~/.config/opencode/instructions/communication.md",
    "~/.config/opencode/instructions/privacy.md",
    "~/.config/opencode/instructions/security.md",
    "~/.config/opencode/instructions/documentation.md"
  ],
  "mcp": {
    "phabricator": {
      "type": "remote",
      "url": "{env:PHABRICATOR_MCP_URL}",
      "enabled": true
    },
    "sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp?skills=inspect",
      "enabled": true
    },
    "grafana": {
      "type": "remote",
      "url": "{env:GRAFANA_MCP_URL}",
      "enabled": true
    },
    "metabase": {
      "type": "remote",
      "url": "{env:METABASE_MCP_URL}",
      "enabled": true
    }
  },
  "permission": {
    "external_directory": {
      "~/.config/agentic/**": "allow",
      "~/.config/opencode/**": "allow",
      "~/.claude/**": "allow"
    },
    "bash": {
      "*": "ask",
      "ls": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "rg *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "grep *": "allow",
      "jq *": "allow",
      "sed -n *": "allow",
      "git grep *": "allow",
      "git fetch": "allow",
      "git fetch *": "allow",
      "gh api *": "allow",
      "wc *": "allow",
      "which *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git show": "allow",
      "git show *": "allow",
      "git branch --show-current": "allow",
      "git rev-parse *": "allow",
      "git merge-base *": "allow",
      "git ls-files": "allow",
      "git ls-files *": "allow",
      "git ls-remote": "allow",
      "git ls-remote *": "allow",
      "git remote -v": "allow",
      "git for-each-ref": "allow",
      "git for-each-ref *": "allow",
      "git stash list": "allow",
      "gh pr view *": "allow",
      "gh pr diff *": "allow",
      "gh pr list": "allow",
      "gh pr list *": "allow",
      "gh pr checks *": "allow",
      "gh issue view *": "allow",
      "gh issue list": "allow",
      "gh issue list *": "allow",
      "gh run view *": "allow",
      "gh run list": "allow",
      "gh run list *": "allow",
      "gh repo view": "allow",
      "gh repo view *": "allow",
      "brew list": "allow",
      "brew list *": "allow",
      "brew info *": "allow",
      "git diff*--output*": "ask",
      "git diff*--ext*": "ask",
      "git log*--output*": "ask",
      "git log*--ext*": "ask",
      "git show*--output*": "ask",
      "git show*--ext*": "ask",
      "rg*--pre*": "ask",
      "sed -n *w*": "ask",
      "sed -n *-i*": "ask",
      "git grep*-O*": "ask",
      "git grep*--op*": "ask",
      "git fetch*--upl*": "ask",
      "git ls-remote*--upl*": "ask",
      "git ls-remote*--exe*": "ask",
      "gh api*-X*": "ask",
      "gh api*--method*": "ask",
      "gh api*-f*": "ask",
      "gh api*-F*": "ask",
      "gh api*--input*": "ask",
      "git push*--force*main*": "deny",
      "git push*--force*master*": "deny",
      "git push*-f*main*": "deny",
      "git push*-f*master*": "deny",
      "git push*--mirror*": "deny",
      "git reset*--hard*": "ask",
      "git clean*-f*": "ask",
      "git branch*-D*": "ask",
      "gh pr merge*": "ask",
      "git filter-branch*": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~*": "deny",
      "rm -rf $HOME*": "deny",
      "sudo*": "deny",
      "dd *": "deny",
      "mkfs*": "deny"
    }
  },
  "watcher": {
    "ignore": [
      "**/.DS_Store",
      "**/Thumbs.db",
      "**/._*",
      "**/.Spotlight-V100",
      "**/.Trashes",
      "**/.fseventsd",
      "node_modules/**",
      "dist/**",
      "build/**",
      ".git/**",
      "__pycache__/**",
      "*.pyc",
      ".venv/**",
      "venv/**",
      "env/**",
      "vendor/**",
      ".idea/**",
      "*.swp",
      "*.swo",
      "*~",
      ".gradle/**",
      "*.class",
      "*.jar",
      "*.war",
      "target/**",
      ".sbt/**",
      "*.egg-info/**",
      ".tox/**",
      ".nox/**",
      ".mypy_cache/**",
      ".ruff_cache/**",
      ".pytest_cache/**",
      "*.spec.js",
      "*.spec.ts",
      "*.test.js",
      "*.test.ts",
      "coverage/**",
      ".nyc_output/**",
      ".next/**",
      ".nuxt/**",
      ".output/**",
      ".cache/**",
      "*.tsbuildinfo",
      ".parcel-cache/**",
      ".turbo/**",
      "*.lock.bak",
      "*.lock",
      "package-lock.json",
      "yarn.lock",
      "pnpm-lock.yaml",
      "bun.lockb",
      "composer.lock",
      "go.sum",
      "Cargo.lock",
      "*.pot",
      "*.po",
      "*.mo",
      ".sass-cache/**",
      ".npm/**",
      ".yarn/**",
      ".pnpm-store/**",
      ".browserslistrc",
      ".babelrc",
      "*.min.js",
      "*.min.css",
      "*.log",
      "logs/**",
      ".wrangler/**",
      ".vercel/**",
      ".serverless/**",
      ".dynamodb/**",
      ".esbuild/**",
      ".tflog/**",
      ".claude/**",
      ".cursor/**",
      ".windsurf/**",
      ".github/**",
      ".env",
      ".env.*",
      "!.env.example",
      "*.local",
      ".tmp/**",
      ".temp/**",
      "*.tmp",
      "*.temp",
      "Thumbs.db",
      ".AppleDouble",
      ".LSOverride",
      ".DocumentRevisions-V100",
      ".com.apple.timemachine.donotpresent"
    ]
  }
}
