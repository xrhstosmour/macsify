# Packages for a personal machine, on top of `base.Brewfile`.
# The path and line arguments make an error inside it name `base.Brewfile`.
base_brewfile = File.join(__dir__, "base.Brewfile")
instance_eval(File.read(base_brewfile), base_brewfile, 1)

# Install necessary third party taps.
tap 'wickenico/wailbrew'

# Install dependencies for various utilities and applications.
brew 'airsync'
brew 'cocoapods'

# Install applications.
cask 'android-commandlinetools'
cask 'brave-browser'
cask 'filen'
cask 'flutter'
cask 'libreoffice'
cask 'localsend'
cask 'macfuse'
cask 'macusb'
cask 'nordvpn'
cask 'rustdesk'
cask 'signal'
cask 'syncthing-app'
cask 'tailscale-app'
cask 'utm'
cask 'veracrypt'
cask 'viber'
cask 'wailbrew'
cask 'whatsapp'
