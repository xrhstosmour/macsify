# Packages installed on every machine, work and personal. `personal.Brewfile` and
# `work.Brewfile` include this file, `brew bundle` runs on one of those, never on this one alone.

# Set the directory for installing applications and casks.
cask_args appdir: '/Applications'

# Install necessary `homebrew`, `macOS` and third party taps.
tap 'buo/cask-upgrade', trusted: true
tap 'xrhstosmour/stege', trusted: true

# Install dependencies for various utilities and applications.
brew 'anomalyco/tap/opencode', trusted: true
brew 'aria2'
brew 'atuin'
brew 'bat'
brew 'bottom'
brew 'eva'
brew 'eza'
brew 'fastfetch'
brew 'fdupes'
brew 'ffmpeg'
brew 'fish'
brew 'fisher'
brew 'fzf'
brew 'gemini-cli'
brew 'getsentry/tools/sentry-cli', trusted: true
brew 'gh'
brew 'git-delta'
brew 'graykode/tap/abtop', trusted: true
brew 'helix'
brew 'herdr'
brew 'jless'
brew 'jq'
brew 'logcli'
brew 'mas'
brew 'media-control'
brew 'mole'
brew 'scrcpy'
brew 'sd'
brew 'shellcheck'
brew 'starship'
brew 'superfile'
brew 'tig'
brew 'tmux'
brew 'witr'
brew 'xh'
brew 'zoxide'

# Install applications.
cask '1password'
cask '1password-cli'
cask 'adobe-acrobat-reader'
cask 'bruno'
cask 'claude-code'
cask 'dockdoor'
cask 'docker-desktop'
cask 'flameshot'
cask 'font-fira-code'
cask 'font-fira-code-nerd-font'
cask 'gitify'
cask 'google-chrome'
cask 'google-drive'
cask 'google-gemini'
cask 'grafviktor/goto/goto-ssh-manager', trusted: true
cask 'maccy'
cask 'mediosz/tap/swipeaerospace', trusted: true
cask 'nikitabobko/tap/aerospace', trusted: true
cask 'obsidian'
cask 'spotify'
cask 'stege'
cask 'visual-studio-code'
cask 'wezterm'
